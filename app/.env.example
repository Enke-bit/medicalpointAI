# Sunucu
PORT=4173
HOST=0.0.0.0

# Nginx / IIS / Caddy arkasında çalışıyorsa 1 yapın (IP bazlı istek sınırı için)
TRUST_PROXY=0

# Dil modeli katmanı. false yapılırsa sistem açıklamaları hiçbir dış servise
# (OpenRouter / Pollinations) gönderilmez; uygulama yalnızca kural motoruyla çalışır.
LLM_ENABLED=true

# OpenRouter anahtarı (.key dosyası yerine canlıda bunu kullanın)
OPENROUTER_API_KEY=
